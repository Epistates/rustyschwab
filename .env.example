# Schwab Rust SDK — environment configuration
# Copy this file to `.env` and fill in the values Schwab gave you.
#
# All variables below are read by `SchwabConfig::from_env()` (called
# from the MCP binary and the `examples/*`). Defaults are noted in
# comments; only the two `SCHWAB_APP_*` secrets are strictly required.

# =====================================================================
# REQUIRED — credentials from https://developer.schwab.com
# =====================================================================

# 32- or 48-character client ID.
SCHWAB_APP_KEY=your_app_key_here

# 16- or 64-character client secret.
SCHWAB_APP_SECRET=your_app_secret_here

# =====================================================================
# OAuth callback (HTTPS required, no trailing slash)
# =====================================================================

# Default, and the recommended value for almost every use case. The
# SDK's built-in callback server listens here and captures the
# redirect automatically; your browser will warn about the self-signed
# cert once, you click through, and you're done.
#
# Register this exact string as a Callback URL in the Schwab Developer
# Portal — Schwab matches it character-for-character.
SCHWAB_OAUTH_CALLBACK_URL=https://127.0.0.1:8080

# =====================================================================
# Token storage
# =====================================================================

# Where refresh tokens are persisted between runs. Default:
# `schwab_tokens.json` in the current working directory. For anything
# but casual dev, use an absolute path under your config dir, e.g.
# ~/.config/schwab/tokens.json
#SCHWAB_TOKENS_FILE=~/.config/schwab/tokens.json

# Token storage backend. Leave unset to use the platform-appropriate
# secure default (Keychain on macOS, EncryptedFile elsewhere).
# Override values: `keychain` | `encrypted` | `file`.
#SCHWAB_TOKEN_STORE=

# =====================================================================
# Optional — token lifecycle tuning
# =====================================================================

# Refresh the access token this many seconds before it expires.
# Schwabdev and our default both use 61. Don't drop below 30.
#SCHWAB_REFRESH_BUFFER=61

# Run the background refresh loop. Leave enabled unless you're
# managing tokens externally.
#SCHWAB_AUTO_REFRESH=true

# PKCE (S256). Schwab does NOT use PKCE in its reference client; only
# enable this if you've confirmed your app accepts code_challenge.
#SCHWAB_PKCE_ENABLED=false

# =====================================================================
# Optional — API endpoints (defaults shown; normally leave unset)
# =====================================================================

#SCHWAB_CLIENT_BASE_URL=https://api.schwabapi.com
#SCHWAB_OAUTH_AUTH_URL=https://api.schwabapi.com/v1/oauth/authorize
#SCHWAB_OAUTH_TOKEN_URL=https://api.schwabapi.com/v1/oauth/token
#SCHWAB_WEBSOCKET_URL=wss://streamer.schwabapi.com/ws

# Streaming is on by default. Flip to false to skip the stream config.
#SCHWAB_STREAMING_ENABLED=true

# =====================================================================
# MCP server (schwab-mcp)
# =====================================================================

# Transport: `stdio` (default — Claude Desktop, mcp-inspector), `http`,
# or `websocket`.
#SCHWAB_MCP_TRANSPORT=stdio

# Bind address for `http` / `websocket` transports.
#SCHWAB_MCP_BIND=127.0.0.1:8765

# Gate for write-side order tools (place_order / cancel_order /
# replace_order). Default: off. preview_order is always available.
#SCHWAB_MCP_ALLOW_TRADING=0

# Redact PII from MCP tool responses (account numbers masked to last
# four, streamer credentials and user identity fields dropped). On by
# default — set to 0 / false / no to disable for local debugging.
#SCHWAB_MCP_REDACT_PII=1

# =====================================================================
# Optional — observability
# =====================================================================

# Expose a Prometheus scrape endpoint at http://<bind>/metrics. Unset
# = no listener, no port bound. Typical value: 127.0.0.1:9090.
#SCHWAB_METRICS_BIND=127.0.0.1:9090

# =====================================================================
# Advanced — public HTTPS tunnels (ngrok / cloudflared / reverse proxy)
# =====================================================================

# Allow the built-in callback server to bind to 0.0.0.0 instead of
# 127.0.0.1. Needed only if you're using an external HTTPS tunnel or
# reverse proxy to terminate TLS in front of this process. Leave off
# unless you know you need it.
#SCHWAB_ALLOW_EXTERNAL_CALLBACK=false
